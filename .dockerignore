# Git and IDE
.git
.gitignore
.idea
.vscode
*.md
!README.md
!plugins/bundle/bank-runtime/skills/**/*.md

# Python dev and cache
__pycache__
*.py[cod]
*$py.class
.venv
venv
uv.lock
.pytest_cache
.coverage
htmlcov
.tox
