# Ops Observer Configuration
# Copy this file to .env and edit as needed.
# Lines starting with # are comments. All keys are optional.

# ── Database ──────────────────────────────────────────────────────
# Leave commented (or empty) to use the default SQLite backend
# (auto-created at <QWENPAW_WORKING_DIR>/ops_observer/observer.sqlite3).
#
# To use MySQL 5.7, uncomment and set:
# OPS_OBSERVER_DB_URL=mysql://user:password@host:3306/database

# OPS_OBSERVER_DB_URL=mysql://root:secret@127.0.0.1:3306/ops_observer

# ── Working directory ─────────────────────────────────────────────
# Root directory for SQLite database and run-summary JSON files.
# Default: ~/.qwenpaw

# QWENPAW_WORKING_DIR=~/.qwenpaw

# ── Secret directory ──────────────────────────────────────────────
# Where the event API token is stored.
# Default: <QWENPAW_WORKING_DIR>.secret

# QWENPAW_SECRET_DIR=~/.qwenpaw.secret
