{
  "id": "bank-runtime-console",
  "name": "Bank Runtime Console",
  "version": "0.1.0",
  "type": "app",
  "description": "Local/dev read-only inspector for Runtime-managed conversations",
  "author": "Bank Agent Runtime Team",
  "entry": {
    "backend": "backend/main.py",
    "frontend": "ui/index.js"
  },
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "pack_exclude": [
    "backend/tests"
  ],
  "meta": {
    "pawapp": {
      "icon": "🔎",
      "category": "development",
      "entry_page": "/apps/bank-runtime-console",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": false,
      "storage": false
    },
    "deployment": {
      "allowed_profiles": ["local", "dev"],
      "production_default": "not-installed"
    }
  }
}
